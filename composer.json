{
  "name": "lacasoft/coatipay-sdk",
  "description": "CoatiPay PHP SDK — the open payment network",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^2.0",
    "kornrunner/keccak": "^1.1",
    "psr/http-factory": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "simplito/elliptic-php": "^1.0"
  },
  "autoload": {
    "psr-4": { "CoatiPay\\": "src/" }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": { "CoatiPay\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "homepage": "https://coatipay.com",
  "support": {
    "source": "https://github.com/lacasoft/coatipay-php-sdk",
    "issues": "https://github.com/lacasoft/coatipay-php-sdk/issues"
  }
}
